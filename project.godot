; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GameScene Studio"
config/description="Create. Animate. Direct. Record."
config/version="0.15.0"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://assets/brand/splash.png"
config/icon="res://assets/brand/icon.png"

[autoload]

App="*res://src/core/app.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/handheld/orientation=6

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/16_bits=false
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.55, 0.78, 1, 1)
anti_aliasing/quality/screen_space_aa=1
